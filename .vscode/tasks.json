{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g", "-O0", "-Wall", "-Wextra",
        "-fsanitize=address,undefined",
        "-fno-omit-frame-pointer",
        "${workspaceFolder}/*.c",
        "-o", "${workspaceFolder}/main"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}